{
  "info": {
    "name": "Dispatch API",
    "description": "Log in first (cookie auth is kept by Postman's cookie jar). All state-changing requests need X-Requested-With: dispatch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "GET /api/health — Liveness probe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "POST /api/auth/register — Register a USER account (admins are seeded, never self-registered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo2@dispatch.dev\",\n  \"password\": \"Dispatch#2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "POST /api/auth/login — Log in (sets the auth cookie). Failed attempts are rate limited.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@dispatch.dev\",\n  \"password\": \"Dispatch#2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "POST /api/auth/logout — Clear the auth cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "GET /api/auth/me — Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "GET /api/tickets — List tickets (users see their own; admins see all)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            }
          }
        },
        {
          "name": "POST /api/tickets — Create a ticket (emits TICKET_CREATED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot reset password\",\n  \"description\": \"The reset email never arrives.\",\n  \"category\": \"ACCOUNT\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            }
          }
        },
        {
          "name": "GET /api/tickets/{id} — Ticket detail. Foreign, deleted or malformed ids return 404.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                ":id"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/tickets/{id} — Edit a ticket (emits TICKET_UPDATED when something changed). Users edit their own OPEN tickets",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                ":id"
              ]
            }
          }
        },
        {
          "name": "DELETE /api/tickets/{id} — Soft-delete your own OPEN ticket",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                ":id"
              ]
            }
          }
        },
        {
          "name": "PATCH /api/tickets/{id}/status — Change status (admin). Emits STATUS_CHANGED, and TICKET_RESOLVED when moving to RESOLVE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                ":id",
                "status"
              ]
            }
          }
        },
        {
          "name": "GET /api/tickets/{id}/activity — Ticket activity timeline (events, oldest first)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "dispatch"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/:id/activity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                ":id",
                "activity"
              ]
            }
          }
        }
      ]
    },
